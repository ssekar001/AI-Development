# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ==================== MongoDB Configuration ====================
# Your MongoDB connection string from Azure Cosmos DB for MongoDB or MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ==================== Azure OpenAI Configuration ====================
# Your Azure OpenAI API key (found in Azure Portal)
AZURE_OPENAI_KEY=your-api-key-here

# Your Azure OpenAI endpoint (found in Azure Portal under "Keys and Endpoint")
# Format: https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API version to use
# Latest stable: 2024-05-01-preview
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Name of your deployed embeddings model
# Common models: text-embedding-3-small, text-embedding-3-large
AZURE_EMBEDDING_MODEL=text-embedding-3-small

# Name of your deployed chat model
# Common models: gpt-4o-mini, gpt-4, gpt-35-turbo
AZURE_CHAT_MODEL=gpt-4o-mini

# ==================== Azure AI Foundry Configuration (Optional) ====================
# If using Azure AI Foundry instead of direct OpenAI API
# Your Azure AI Foundry project endpoint
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/

# Your deployment name for the foundry project
AZURE_FOUNDRY_PROJECT_DEPLOYMENT_NAME=your-deployment-name

# ==================== Application Settings ====================
# Optional: Application environment (development, staging, production)
ENVIRONMENT=development

# Optional: Enable debug logging
DEBUG=false
